# Ruta en tu máquina host donde viven los repos de LinkaForm
# (lkf-claude, lkf-addons, clave10, etc.) — se monta en el contenedor con
# el mismo path absoluto, para que Claude Code encuentre el historial de
# sesiones (se indexa por cwd absoluto). Debe ser una ruta absoluta, sin "~".
LKF_HOST_PATH=/home/tu-usuario/lkf

# GID del grupo dueño de /var/run/docker.sock en el host (`stat -c '%g' /var/run/docker.sock`).
# Se agrega al usuario `node` dentro del contenedor para poder correr docker/docker compose.
DOCKER_GID=999
